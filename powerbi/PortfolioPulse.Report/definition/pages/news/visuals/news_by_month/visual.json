              },
              "queryRef": "dim_date.year_month",
              "nativeQueryRef": "year_month",
              "displayName": "Month",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Unique stories"
                }
              },
              "queryRef": "_Measures.Unique stories",
              "nativeQueryRef": "Unique stories",
              "displayName": "Unique stories"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_watchlist"
