                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1A1A19",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "older than expected: more than 4 days for portfolio data, more than 7 days for news.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#55544F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "MISSING ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1A1A19",
                      "fontWeight": "bold"
