                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#1A1A19",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "DEMO ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1A1A19",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "synthetic data, for illustration only.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#55544F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "reported ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1A1A19",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "taken directly from a source, such as a broker or a posted bank rate.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#55544F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "estimated ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1A1A19",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "calculated using a stand-in, such as the Bank of Canada rate in place of a platform's own rate.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#55544F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
