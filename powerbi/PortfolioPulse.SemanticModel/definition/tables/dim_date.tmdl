		summarizeBy: none
		sourceColumn: weekday
		sortByColumn: weekday_num

		annotation SummarizationSetBy = User

	column is_weekday
		dataType: boolean
		lineageTag: 6be205de-90a4-570d-9344-f366a5def2bd
		summarizeBy: none
		sourceColumn: is_weekday

		annotation SummarizationSetBy = User

	column week_start
		dataType: dateTime
		formatString: mmm d
		lineageTag: 5cf8d799-8221-55d8-97ec-3b6b987260da
		summarizeBy: none
		sourceColumn: week_start

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	partition dim_date = m
		mode: import
		source =
				let
				    Source = fnLoadCsv("dim_date", {
				        {"date", type date}, {"year", Int64.Type}, {"month_num", Int64.Type}, {"month", type text},
				        {"year_month", type text}, {"week_of_year", Int64.Type}, {"weekday_num", Int64.Type},
				        {"weekday", type text}, {"is_weekday", type logical}}),
				    // Monday of each date's week: one calendar row per week (model-side only; the CSV contract is unchanged)
				    WeekStart = Table.AddColumn(Source, "week_start", each Date.AddDays([date], 1 - [weekday_num]), type date)
				in
				    WeekStart

	annotation PBI_ResultType = Table
