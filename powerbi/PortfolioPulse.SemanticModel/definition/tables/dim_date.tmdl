table dim_date
	lineageTag: b699eab8-ab75-5048-b881-242df1c2082c
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: ee30afdc-3b2e-500d-84af-361bb450e3cb
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

