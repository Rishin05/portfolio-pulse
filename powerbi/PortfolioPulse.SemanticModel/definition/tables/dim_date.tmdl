		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = User

	column month_num
		dataType: int64
		formatString: 0
		lineageTag: 973611f8-07bd-5286-ab7c-b43a218b9d23
		summarizeBy: none
		sourceColumn: month_num

		annotation SummarizationSetBy = User

	column month
		dataType: string
		lineageTag: 4b328571-d6fa-50cc-8232-1b978624c16c
		summarizeBy: none
		sourceColumn: month
		sortByColumn: month_num

		annotation SummarizationSetBy = User

	column year_month
		dataType: string
		lineageTag: 939c213c-13c9-5227-8312-61b0846b7c67
		summarizeBy: none
		sourceColumn: year_month

		annotation SummarizationSetBy = User

	column week_of_year
		dataType: int64
		formatString: 0
		lineageTag: 2108ba8d-2831-59ba-8d1f-8c03682bdea8
		summarizeBy: none
		sourceColumn: week_of_year

		annotation SummarizationSetBy = User

	column weekday_num
		dataType: int64
		formatString: 0
		lineageTag: 6f86388e-6f91-53be-abf0-a965b5335f2b
		summarizeBy: none
		sourceColumn: weekday_num

		annotation SummarizationSetBy = User

	column weekday
