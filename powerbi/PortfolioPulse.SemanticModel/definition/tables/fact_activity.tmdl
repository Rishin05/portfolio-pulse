	partition fact_activity = m
		mode: import
		source =
				let
				    Raw     = Csv.Document(File.Contents(DataFolder & "fact_activity.csv"),
				                  [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
				    Nulls   = Table.TransformColumns(Headers,
				                  List.Transform(Table.ColumnNames(Headers), (c) => {c, each if _ = "" then null else _})),
				    DateOnly = Table.TransformColumns(Nulls,
				                  {{"trade_date", each if _ = null then null else Text.Start(_, 10), type text}}),
				    Source  = Table.TransformColumnTypes(DateOnly, {
				        {"activity_id", type text}, {"account_id", type text}, {"activity_type", type text}, {"raw_type", type text},
				        {"trade_date", type date}, {"symbol", type text}, {"quantity", type number}, {"amount", type number},
				        {"currency", type text}, {"fx_rate", type number}, {"fx_rate_date", type date}, {"fx_gap_days", Int64.Type},
				        {"fx_status", type text}, {"amount_cad", type number}, {"counter_amount", type number},
				        {"counter_currency", type text}, {"counter_amount_cad", type number}, {"counter_fx_status", type text},
				        {"reported_fx_rate", type number}, {"fx_conversion_cost_cad", type number}, {"quality_flag", type text},
				        {"source_id", type text}}, "en-CA")
				in
				    Source

	annotation PBI_ResultType = Table

