		sourceColumn: generated_at_utc

		annotation SummarizationSetBy = User

	partition check_totals = m
		mode: import
		source =
				let
				    // SQL control totals written by scripts/reconcile_powerbi.py. If the file is not there yet,
				    // load an empty table so the rest of the report still refreshes.
				    Empty  = #table(
				                 type table [check_id = text, check_name = text, unit = text, sql_value = number,
				                             tolerance = number, generated_at_utc = text], {}),
				    Loaded = try Table.Buffer(fnLoadCsv("check_totals", {
				                 {"check_id", type text}, {"check_name", type text}, {"unit", type text},
				                 {"sql_value", type number}, {"tolerance", type number}, {"generated_at_utc", type text}}))
				             otherwise Empty
				in
				    Loaded

	annotation PBI_ResultType = Table
