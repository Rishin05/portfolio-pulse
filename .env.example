# Copy to .env (which is git-ignored) and fill in. Never commit .env.
# Optional: where the SQLite database lives.
PULSE_DB_PATH=
# Optional: SnapTrade Personal API key (read-only use) from https://dashboard.snaptrade.com/api-key
# Personal auth needs only these two values: no userId/userSecret. Leave blank to skip SnapTrade.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Optional: Finnhub API key (company news) from https://finnhub.io/dashboard
# Sent only in the X-Finnhub-Token header, never in URLs or logs. Leave blank to skip Finnhub.
FINNHUB_API_KEY=
# Optional: 1 = let `fetch-news` (auto) and run-daily fall back to Google News RSS for symbols
# Finnhub can't cover (e.g. TSX-only ETFs). Personal, non-commercial use. Blank = off.
NEWS_RSS_FALLBACK=
# Optional RSS tuning (blank = default): look-back window in days (1-30, default 7)
# and max headlines kept per symbol per run, newest first (1-100, default 25).
NEWS_RSS_WINDOW_DAYS=
NEWS_RSS_MAX_ITEMS=